# Copy this file to .env to override defaults (all values are optional).
PORT=3000
# Largest allowed upload, in megabytes
MAX_FILE_SIZE_MB=25
# Longest allowed chat message, in characters
MAX_MESSAGE_LENGTH=2000
# How many recent messages new users see when they join
HISTORY_LIMIT=200
# Uploaded files older than this are deleted automatically
UPLOAD_RETENTION_HOURS=24
# Only needed if the page is served from a different origin (comma-separated)
# CORS_ORIGIN=http://localhost:5173
